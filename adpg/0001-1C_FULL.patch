+										 DEFAULT_COLLATION_OID,
+										 v1, v2,
+										 Int32GetDatum(record_cmp_prefix)));
+
+	if (cmp)
+		return -1;
+
+	cmp = DatumGetBool(FunctionCall3Coll(eqproc,
