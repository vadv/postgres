+static bool
+IsQueryMatch(const char* query, const char* pattern)
+{
+	while (*query)
+	{
+		char const* q = query;
+		char const* p = pattern;
+		bool match = true;
+
+		while (*p)
+		{
+			if (*q == '\r' || *q == '\n')
+			{
+				if (!isspace(*p))
+				{
+					match = false;
+					break;
+				}
+
+				while (isspace(*p))
+					p++;
+
+				while (isspace(*q))
+					q++;
+			}
+			else if (*q == *p)
+			{
+				q++;
+				p++;
+			}
+			else
+			{
+				match = false;
+				break;
+			}
+		}
+
+		if (match)
+			return true;
+
+		query++;
+	}
+
+	return false;
+}
