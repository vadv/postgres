+
+static void
+appendSelectivityRes(Selectivity s[CorrelationKindCount], Selectivity sel, CorrelationKind ck)
+{
+	switch(ck)
+	{
+		case CKRestrict:
+			s[ck] *= sel;
+			break;
+		case CKSelf:
+		case CKLikelySelf:
+			s[CKMul] *= sel;
+			if (s[ck] > sel)
+				s[ck] = sel;
+			/* FALLTHROUGH */
+		case CKIndepend:
+			s[CKIndepend] *= sel;
+			break;
+		case CKLikelyCorrelated:
+			if (sel < s[ck])
+				s[ck] = sel;
+			else
+				s[ck] *= pow(sel, 0.2);
+			break;
+		default:
+			elog(ERROR, "unknown selectivity kind: %d", ck);
+	}
+}
+
+static Selectivity
+finalizeSelectivityRes(Selectivity s[CorrelationKindCount])
+{
+	Selectivity	sel;
+
+	sel = s[CKRestrict] * s[CKIndepend] * s[CKLikelyCorrelated];
+
+	if (s[CKIndepend] != s[CKMul])
+	{
+		/* we have both independ and correlated - fallback */
+		sel *= s[CKMul];
+	}
+	else
+	{
+		/* we have only correlated join clauses */
+		if (s[CKLikelySelf] != 1.0 && sel < s[CKLikelySelf])
+			sel = sel + (s[CKLikelySelf] - sel) * 0.25;
+
+		if (s[CKSelf] != 1.0 && sel < s[CKSelf])
+			sel = sel + (s[CKSelf] - sel) * 1.0;
+	}
+
+	return sel;
+}
