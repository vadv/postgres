+static bool
+have_multicolumn_statistics(IndexOptInfo *index, int n_index_cols)
+{
+	HeapTuple statsTuple =  SearchSysCache3(STATRELATTINH,
+							ObjectIdGetDatum(index->indexoid),
+							Int16GetDatum(n_index_cols),
+							BoolGetDatum(false));
+	if (!statsTuple)
+		return false;
+
+	ReleaseSysCache(statsTuple);
+	return true;
+}
