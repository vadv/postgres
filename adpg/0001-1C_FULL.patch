diff --git a/contrib/plantuner/plantuner.c b/contrib/plantuner/plantuner.c
new file mode 100644
index 0000000..82996e3
--- /dev/null
+++ b/contrib/plantuner/plantuner.c
@@ -0,0 +1,571 @@
